    {
      "id": "F4eow55JqnqU1Xc3L-t85",
      "type": "text",
      "x": 3593.4647233072924,
      "y": -2313.130952380954,
      "width": 1495.00146484375,
      "height": 688.9999999999998,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
