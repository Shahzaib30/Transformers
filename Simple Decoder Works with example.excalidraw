        }
      ],
      "updated": 1779604680409,
      "link": null,
      "locked": false,
      "text": "Qx = X.q = (4,128).(128,128)\nwe know 128 == 128 so it is valid mat mul\nand now the size of Qx become = (4, 128)",
      "fontSize": 47.999999999999986,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qx = X.q = (4,128).(128,128)\nwe know 128 == 128 so it is valid mat mul\nand now the size of Qx become = (4, 128)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "my3U3-gaplfTpyg82ExoA",
